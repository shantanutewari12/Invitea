# Copy to .env.local and fill in. Secrets are server-side only; only NEXT_PUBLIC_* reach the browser.

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Postgres, Auth, Storage) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used by the token API, RSVP upsert, payments and rate limiting.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI (Gemini behind the LLMProvider interface) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Razorpay ---
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- PostHog (cookieless, no PII) ---
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Testing only. NEVER set on a real deployment. ---
# REGALIA_E2E_FIXTURES=1
